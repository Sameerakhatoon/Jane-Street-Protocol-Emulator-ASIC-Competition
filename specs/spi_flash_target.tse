// spi_flash_target.tse: SPI NOR flash personality, mode 0, for a flashrom-driven demo.
//
// Source: the instruction set common to serial NOR flash, as in the Winbond
// W25Q16JV datasheet (instruction tables and the instruction descriptions):
//   0x9F  JEDEC ID          out: manufacturer, memory type, capacity (3 bytes)
//   0x05  read status 1     out: status, repeated while CS stays low (bit 1 = WEL, bit 0 = BUSY)
//   0x06  write enable      sets WEL
//   0x03  read data         in: 24-bit address; out: data bytes until CS rises
//   0x02  page program      in: 24-bit address, then data bytes; needs WEL; clears WEL
//   0x20  sector erase 4K   in: 24-bit address; needs WEL; clears WEL
// Mode 0 timing as in spi_target.tse: sample MOSI after SCK rises, change MISO
// after SCK falls. Erase and program complete at once (BUSY reads 0).
//
// Who keeps what. The host keeps the flash image, and with it every piece of
// state that outlives one chip-select frame: the write enable latch, the
// status byte and the JEDEC ID. The lane pushes the opcode of every command
// (and the address, and the bytes to program), so the host sees 0x06 set WEL,
// ignores a program or erase while WEL is clear (the datasheet's rule), and
// clears WEL after one. For 0x9F, 0x05 and 0x03 the lane pushes the opcode
// and pulls the bytes to send; `assume host_ready` states that the host word
// is there by the first falling edge after the opcode, which the simulated
// demo's host model meets and a real host behind a slow link would not.
// Written this way the lane needs no flag kept across states.
//
// Hand-computed obligations, windows inward, pads 0 to 25 ns, with the SCK
// rate this lane is proven at (3 MHz at 60 MHz, 2.5 MHz at 50 MHz):
//
//   obligation               window                 60 MHz, 3 MHz                 50 MHz, 2.5 MHz
//   mosi  OB-WIN after rise   [0, half - t_mo]       [0, 146.7 ns]; achieved       [0, 180 ns]; achieved
//                                                   16.7 to 108.3 ns, margin 38.3  20 to 125 ns, margin 55
//   miso  OB-WIN after fall   [0, half - t_su]       [0, 161.7 ns]; achieved       [0, 195 ns]; achieved
//                                                   66.7 to 158.3 ns, margin 3.3   80 to 185 ns, margin 10
//   abort on rise(cs_n)      stated bound           a WAIT alternate in every byte loop
//
// At the demo's first choice of 4 MHz the MISO window is [0, 120 ns] and the
// lane reaches 158.3 ns: rejected with the fix f_sck <= 3.06 MHz (3.61 MHz
// with ideal pads); at 50 MHz the limit is 2.63 MHz. flashrom's serprog
// driver sets the SPI speed, so the demo asks for 3 MHz (2.5 MHz at 50 MHz).
// A read served from the data window instead of the host needs an indexed
// load the language cannot state yet (the address is data, not a constant).
protocol spi_flash_target {
  param f_sck    : freq = 3 MHz;
  param t_su     : time = 5 ns;            // controller's MISO setup before its sampling edge
  param t_css    : time = 100 ns;          // controller's CS fall to first SCK rise
  param t_mo     : time = 20 ns;           // controller's MOSI output delay after SCK falls
  unit  half     = 1 / (2 * f_sck);

  wire cs_n : in;
  wire sck  : in;
  wire mosi : in;
  wire miso : out push_pull idle 0;

  datasheet spi_controller {
    rule sck_low  : fall(sck)  -> rise(sck) >= half;
    rule sck_high : rise(sck)  -> fall(sck) >= half;
    rule css      : fall(cs_n) -> rise(sck) >= t_css;
  }

  role flash : target uses cs_n, sck, mosi, miso {
    var op   : bits[8];
    var addr : bits[24];
    var din  : bits[8];
    var id   : bits[24];
    var sr   : bits[8];
    var dout : bits[32];
    assume host_ready : host.ready;

    state idle { on fall(cs_n) -> opcode; }

    state opcode {
      seq {
        repeat 8 { shift mosi -> op msb 1 within [0 ns, half - t_mo] after rise(sck); }
      } -> decode abort on rise(cs_n) -> idle;
    }

    state decode {
      after op == 0x9F -> jedec;
      after op == 0x05 -> status;
      after op == 0x03 -> read_addr;
      after op == 0x06 -> write_enable;
      after op == 0x02 -> prog_addr;              // the host applies the WEL rule
      after op == 0x20 -> erase_addr;
      after op != 0x9F -> ignore;                 // unknown: stay off the bus
    }

    state jedec {
      seq {
        push host op;
        pull host id;
        repeat 24 { shift id msb 1 -> miso within [0 ns, half - t_su] after fall(sck); }
      } -> ignore abort on rise(cs_n) -> idle;
    }

    state status {
      seq { push host op; } -> status_byte;
    }

    state status_byte {
      seq {
        pull host sr;
        repeat 8 { shift sr msb 1 -> miso within [0 ns, half - t_su] after fall(sck); }
      } -> status_byte abort on rise(cs_n) -> idle;
    }

    state write_enable {
      seq { push host op; } -> ignore;            // the host sets WEL
    }

    state read_addr {
      seq {
        push host op;
        repeat 24 { shift mosi -> addr msb 1 within [0 ns, half - t_mo] after rise(sck); }
        push host addr;
      } -> read_data abort on rise(cs_n) -> idle;
    }

    state read_data {
      seq {
        pull host dout;
        repeat 32 { shift dout msb 1 -> miso within [0 ns, half - t_su] after fall(sck); }
      } -> read_data abort on rise(cs_n) -> idle;
    }

    state prog_addr {
      seq {
        push host op;
        repeat 24 { shift mosi -> addr msb 1 within [0 ns, half - t_mo] after rise(sck); }
        push host addr;
      } -> prog_data abort on rise(cs_n) -> idle;
    }

    state prog_data {
      seq {
        repeat 8 { shift mosi -> din msb 1 within [0 ns, half - t_mo] after rise(sck); }
        push host din;
      } -> prog_data abort on rise(cs_n) -> idle;
    }

    state erase_addr {
      seq {
        push host op;
        repeat 24 { shift mosi -> addr msb 1 within [0 ns, half - t_mo] after rise(sck); }
        push host addr;
      } -> ignore abort on rise(cs_n) -> idle;
    }

    state ignore { on rise(cs_n) -> idle; }        // until CS rises
  }
}
