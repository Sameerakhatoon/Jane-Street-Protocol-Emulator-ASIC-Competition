// jtag_probe.tse: JTAG controller (probe), TCK at 5 MHz, 16 TMS/TDI pairs per host word.
//
// Source: IEEE 1149.1 (test access port and boundary-scan architecture),
// clause 4, the test access port: the target samples TMS and TDI on the rising
// edge of TCK and changes TDO on the falling edge; TDO is valid from the
// falling edge until the next falling edge. The TAP state walk (which TMS
// sequence reaches Shift-DR, TMS high on the last bit of a scan) belongs to
// the target's state machine and is computed by the host (as OpenOCD's
// bit-bang drivers do), so the lane is a fixed shifter of (TMS, TDI) pairs
// that returns the TDO bits.
//
// Timing of one pair, from the falling edge F:
//   F                 TCK falls, TMS and TDI change (one action: side-set)
//   F + half          TCK rises: the target samples TMS and TDI
//   F + 2 half - t_rd we sample TDO, t_rd before the next falling edge
// TDO was launched at F, so sampling late in the high phase gives the round
// trip almost a full TCK period. The captured bit is the same one a sample at
// the rising edge would see, because TDO only changes on falling edges.
//
// Hand-computed obligations at f_tck = 5 MHz (half = 100 ns), t_rd = 20 ns,
// t_jit = 5 ns (0.30 tick at 60 MHz, 0.25 tick at 50 MHz). Pair period 12 / 10 ticks.
// t_smp = 10 ns for the TDO sample: it only has to stay inside the valid window (hold
// margin t_rd - t_smp = 10 ns), so it does not take the TCK edge tolerance.
//
//   obligation                         ideal       60 MHz                50 MHz
//   OB-EDGE TCK fall + TMS, TDI         0           0, error 0            0, error 0
//   OB-EDGE TCK rise                    half        6, error 0            5, error 0
//   OB-SAMP TDO                         2 half - t_rd   10.8 -> 11, 0.20  9, error 0
//   16 pairs: last edge at 192 / 160 ticks, 50 ppm drift 0.01 tick
//
//   TDO round trip   valid t_tdo + 25 ns pads = 55 ns after F at our pin;
//                    sample at 183.3 ns (60) / 180 ns (50): margin 128.3 / 125 ns
//                    (sampling at the rising edge, half - t_rd = 80 ns, would
//                    leave 28.3 / 25 ns)
//   TDO hold         sample 16.7 / 20 ns before the next fall; TDO changes only
//                    after that fall: margin >= 16.7 ns
//   TMS/TDI setup    change at F, half = 100 ns before the rise, held half after it
//
//   rate              60 MHz                                  50 MHz
//   5 MHz             accepted (above)                        accepted (above)
//   7.5 MHz (clk/8)   half 4 ticks, sample 7 = 116.7 ns,      half 3.33 ticks, rise error 0.33
//                     round trip margin 61.7 ns               against 0.25: rejected
//   8 MHz             period 7.5 ticks: the second fall is    period 6.25 ticks: the third fall
//                     0.5 tick off: rejected                  is 0.5 tick off: rejected
// The silicon claim stays 5 MHz with the 25 ns pad budget; the simulated demo
// target has no pads, so its spec sets t_tdo and the pad budget to its values.
// t_tdo is stated but not used by a statement: the round trip is a window
// anchored on our own TCK edge (within [t_tdo + pads, ...] after fall(tck)), and
// pin events on an output wire are rejected (E203), so that row is
// checked by hand only.
protocol jtag_probe {
  param f_tck : freq = 5 MHz;
  param t_rd  : time = 20 ns;          // sample TDO this long before the next falling edge
  param t_jit : time = 5 ns;           // placement tolerance of every TCK, TMS and TDI edge
  param t_smp : time = 10 ns;          // placement tolerance of the TDO sample
  param t_tdo : time = 30 ns;          // target: TDO valid after TCK falls (its datasheet)
  unit  half  = 1 / (2 * f_tck);

  wire tck : out push_pull idle 0;
  wire tms : out push_pull idle 1;
  wire tdi : out push_pull idle 1;
  wire tdo : in;

  role probe : controller uses tck, tms, tdi, tdo {
    var cmd : bits[32];                // 16 (TMS, TDI) pairs, TMS in the lower bit of each pair
    var cap : bits[16];
    state idle { on host.pull(cmd) -> scan; }
    state scan {
      seq {
        repeat 16 {
          drive tck = 0;                                   // shares the instant of the next shift
          shift cmd lsb 2 -> (tms, tdi) for half ~ t_jit;
          drive tck = 1 for half - t_rd ~ t_jit;           // the target samples TMS and TDI
          shift tdo -> cap lsb 1 for t_rd ~ t_smp;
        }
        drive tck = 0 for half ~ t_jit;
        push host cap;
      } -> idle;
    }
  }
}
