// spi_target_mode0_css114.tse: SPI target, mode 0, restated for the CS setup time
// the lane really needs.
//
// spi_target.tse states a controller whose CS falls only t_css = 100 ns before
// the first SCK rise, which leaves the first MISO bit a window of
// [0, t_css - t_su] = [0, 95 ns]. The sequencer reacts to the CS fall exactly
// one cycle after seeing it, on every path, and the pin then changes 66.7 to
// 108.3 ns after the fall at 60 MHz (80 to 125 ns at 50 MHz), pads 0 to 25 ns
// included. So that spec is rejected (R311, fix t_css >= 114 ns) and stays
// rejected until a response rule can drive the first bit (an RTL change: a
// rule drive that ends on another pin's edge, which the RTL does not have).
// This file is the same target with the controller requirement the RTL
// lane really meets. The name keeps the first estimate, 114 ns, because the
// demo and the judge manifest refer to it.
//
// Two limits, the second one binding (one tick = 16.67 ns at 60 MHz, 20 ns at 50 MHz):
//
//   first_bit  OB-WIN   [0, t_css - t_su]    MISO 67.0 to 86.2 ns after the fall with the
//                                            tile pads (0.32 to 2.87 ns), 66.7 to 104.3 ns
//                                            with the full pad path (0 to 21 ns): needs
//                                            t_css >= 91.2 ns / 109.3 ns
//   first rise          OB-REARM             after the fall the lane drives MISO and sets
//                                            its counter before it waits for the first
//                                            rise: 7 ticks, so t_css >= 116.7 ns at 60 MHz
//                                            (116.6 ns is rejected), 140 ns at 50 MHz
//                                            (130 ns is rejected), at any pad setting
//   byte gap            OB-REARM             push, then wait for the SCK level: f_sck <=
//                                            2.14 MHz at 60 MHz (1.7 MHz proven at 50 MHz)
//
// So the claim is t_css >= 117 ns and f_sck <= 2 MHz at 60 MHz (140 ns and
// 1.7 MHz at 50 MHz). Driving the first bit while armed, before CS falls,
// would lower the re-arm limit to about 84 ns (84 ns builds, 80 ns is
// rejected, on a variant of this file with the tile pads), but MISO would then show
// data while the target is not selected. Controllers that hold CS for a
// whole SCK period before the first edge (250 ns at 2 MHz) meet 117 ns easily.
protocol spi_target_mode0_css114 {
  param f_sck : freq = 2 MHz;          // fastest SCK the controller will use
  param t_su  : time = 5 ns;           // controller's MISO setup before its sampling edge
  param t_css : time = 117 ns;         // controller's CS fall to first SCK rise
  param t_mo  : time = 20 ns;          // controller's MOSI output delay after SCK falls
  unit  half  = 1 / (2 * f_sck);

  wire cs_n : in;
  wire sck  : in;
  wire mosi : in;
  wire miso : out push_pull idle 0;

  datasheet spi_controller {
    rule sck_low  : fall(sck)  -> rise(sck) >= half;
    rule sck_high : rise(sck)  -> fall(sck) >= half;
    rule css      : fall(cs_n) -> rise(sck) >= t_css;
  }

  role tgt : target uses cs_n, sck, mosi, miso {
    var txw : bits[32];                // four bytes from the host, MSB first
    var rxb : bits[8];
    assume window_loaded : host.window_loaded;
    state idle  { on host.pull(txw) -> armed; }
    state armed {
      respond first_bit : on fall(cs_n) { shift txw msb 1 -> miso; }
                          within [0 ns, t_css - t_su] -> bits;
    }
    state bits {
      seq {
        repeat 8 {
          shift mosi -> rxb msb 1 within [0 ns, half - t_mo] after rise(sck);
          shift txw msb 1 -> miso within [0 ns, half - t_su] after fall(sck);
        }
        push host rxb;
      } -> bits abort on rise(cs_n) -> idle;
    }
  }
}
