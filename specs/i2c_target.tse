// i2c_target.tse: I2C target at address 0x50, Fast-mode (400 kHz), with clock stretching.
//
// Hand-computed obligations at 60 MHz (one tick = 16.67 ns). Windows round
// inward: lower bounds up, upper bounds down. Pads add 0 to 25 ns.
//
//   obligation                 window              ticks      implementation                  worst case               margin (low, high)
//   ack, ack_w        OB-WIN   [300 ns, 900 ns]    [18, 54]   response rule, pin-edge mode,   [21, 22] ticks + pads    50.0 ns, 508.3 ns
//                              after fall(scl)                SCL falling, tick_delay 18      = 350.0 to 391.7 ns
//   data bits and     OB-WIN   [300 ns, 900 ns]    [18, 54]   WAIT 0 scl, DLY 14,             [19, 20) ticks + pads    16.7 ns, 541.7 ns
//   SDA releases               after fall(scl)                SET PINDIRS (D = 16)            = 316.7 to 358.3 ns
//   stretch           OB-WIN   [0, t_low - margin] [0, 66]    SET PINDIRS right after the     [4, 5) ticks + pads      991.7 ns
//   (drive scl = 0)            = [0, 1.1 us]                  WAIT, buffered word (D = 1)     = 66.7 to 108.3 ns
//   setup before      OB-HOLD  wait t_su_dat       >= 6       DLY 5                           exactly 6 ticks          0 (ours, placed exactly)
//   releasing SCL
//
// Assumptions (the controller's side): the four i2c_fm rules. While we hold
// SCL low (state load) no window runs, so the host may take as long as it likes.
// The compiler builds every window above with the sequencer (data and ACK at
// 316.7 ns, stretch at 100 ns) but rejects the spec (R314): a stop may follow a
// start at once, and the program arms its stop detection 12 cycles after the
// start. A rule start -> stop >= 216.7 ns (not in the I2C standard) makes it build.
protocol i2c_target {
  param addr7    : bits[7] = 0x50;
  const t_hd_int : time = 300 ns;     // internal SDA hold after SCL falls
  const t_vd     : time = 0.9 us;     // tVD;DAT and tVD;ACK, Fast-mode
  const t_low    : time = 1.3 us;     // controller's minimum SCL low time
  const t_su_dat : time = 100 ns;
  const margin   : time = 200 ns;

  wire scl : inout open_drain pull_up;
  wire sda : inout open_drain pull_up;

  event start = fall(sda) when scl == 1;
  event stop  = rise(sda) when scl == 1;

  datasheet i2c_fm {
    rule t_hd_sta : start     -> fall(scl) >= 0.6 us;
    rule t_low    : fall(scl) -> rise(scl) >= t_low;
    rule t_high   : rise(scl) -> fall(scl) >= 0.6 us;
    rule t_su_dat : edge(sda) -> rise(scl) >= t_su_dat when scl == 0;
    rule t_su_sto : rise(scl) -> stop      >= 0.6 us;
  }

  role tgt : target uses scl, sda {
    var sh  : bits[8];
    var out : bits[8];

    state idle { on start -> addr; }

    state addr {                                   // 7 address bits and R/W, MSB first
      seq {
        repeat 8 { await rise(scl); shift sda -> sh msb 1; }
      } -> decide abort on stop -> idle;
    }

    state decide {                                 // waiting for the 8th falling edge
      respond ack : on fall(scl) when sh[7:1] == addr7
                    { drive sda = 0; } within [t_hd_int, t_vd] -> ack_slot;
      on fall(scl) -> idle;                        // not our address: stay off the bus
    }

    state ack_slot {                               // SDA held low; waiting for the 9th fall
      on fall(scl) when sh[0] == 1 do {            // read: hold SCL until the host has a byte
        drive scl = 0 within [0 ns, t_low - margin] after fall(scl);
        release sda within [t_hd_int, t_vd] after fall(scl);
      } -> load;
      on fall(scl) do {                            // write: just end the ACK
        release sda within [t_hd_int, t_vd] after fall(scl);
      } -> wdata;
    }

    state load {                                   // we own SCL low: no window applies
      on host.pull(out) do {
        shift out msb 1 -> sda;
        wait t_su_dat;
        release scl;                               // end of the stretch
      } -> rdata;
    }

    state rdata {                                  // 7 more data bits, then the controller's ACK
      seq {
        repeat 7 {
          shift out msb 1 -> sda within [t_hd_int, t_vd] after fall(scl);
        }
        release sda within [t_hd_int, t_vd] after fall(scl);
        await rise(scl);
        sample sda;                                // 0 = controller wants another byte
      } -> ack_slot_read abort on stop -> idle;
    }

    state ack_slot_read {
      on fall(scl) when sda == 0 do {
        drive scl = 0 within [0 ns, t_low - margin] after fall(scl);
      } -> load;
      on fall(scl) -> idle;                        // NACK: the controller will send STOP
    }

    state wdata {
      seq {
        repeat 8 { await rise(scl); shift sda -> sh msb 1; }
        push host sh;
      } -> decide_w abort on stop -> idle;
    }

    state decide_w {
      respond ack_w : on fall(scl) { drive sda = 0; } within [t_hd_int, t_vd] -> ack_slot_w;
    }

    state ack_slot_w {                             // after a written byte: just end the ACK
      on fall(scl) do { release sda within [t_hd_int, t_vd] after fall(scl); } -> wdata;
    }
  }
}
