// spi_controller_mode1.tse: SPI controller, mode 1 (CPOL = 0, CPHA = 1).
//
// Transmission format (CPOL/CPHA formats of the Motorola SPI block, the
// convention every SPI datasheet follows): SCK idles low; data is launched
// on the rising (leading) edge and sampled on the falling (trailing) edge, so
// the first bit appears with the first edge.
// The four mode files differ only in the SCK levels and its idle level.
//
// Host interface. The host pulls one control byte per step: 1 asserts CS,
// 2 transfers 8 bits, 4 transfers 32 bits (both pull the MOSI data and push
// the MISO data), 3 releases CS. A flash command is then a sequence such as
// 1, 4 (0x03 and a 24-bit address), 4, 4, ..., 3. The clock simply stops
// between steps, which SPI allows.
//
// Timing of one bit, from its launch instant L:
//   L               SCK rises (leading edge) and MOSI changes
//   L + half        SCK falls: the target samples MOSI
//   L + 2 half - t_rd  we sample MISO, t_rd before the next launch edge
//   L + 2 half      next bit
// Sampling late in the bit (read-sample tuning) gives the round trip
// (our SCK pad, the target's output delay, its MISO pad) almost a full SCK
// period instead of half of one.
//
// Target-side numbers this file must respect (typical serial NOR flash, for
// example the AC characteristics of the Winbond W25Q16JV datasheet):
//   t_v    MISO valid after its launching SCK edge     max 8 ns  (tCLQV class)
//   t_css  CS low to the first SCK edge                 min 5 ns  (tSLCH class)
//   t_csd  CS high time between commands                min 50 ns (tSHSL class)
// t_css = 100 ns here also satisfies the 100 ns assumption of spi_target.tse.
//
// Hand-computed obligations at f_sck = 5 MHz (half = 100 ns), t_rd = 20 ns,
// edge tolerance t_jit = 5 ns (60 MHz: 0.30 tick, 50 MHz: 0.25 tick).
// sample tolerance t_smp = 10 ns: the MISO sample only has to stay inside the bit's valid
// window (round trip margin above 120 ns, hold margin t_rd - t_smp = 10 ns), so it does not
// take the SCK edge tolerance; with the full pad path (skew 3.5 ns) the 0.20 tick rounding
// plus the skew is 6.8 ns.
//
//   obligation                ideal in the bit    60 MHz (ticks)   error   50 MHz (ticks)   error
//   OB-EDGE launch (SCK, MOSI)  0                 0                0       0                0
//   OB-EDGE SCK rise            half              6                0       5                0
//   OB-SAMP MISO                2 half - t_rd     10.8 -> 11       0.20    9                0
//   bit period                  2 half            12                       10
//   32 bits: last edge at 384 ticks (60) / 320 (50); 50 ppm drift 0.019 / 0.016 tick, inside 0.30 / 0.25
//
//   round trip (MISO sample)   needs t_v + 25 ns pads = 33 ns after the launch edge
//                              sample at 183.3 ns (60) / 180 ns (50): margin 150.3 ns / 147 ns
//   MISO hold                   sample 16.7 ns (60) / 20 ns (50) before the next launch edge; the
//                              target changes MISO only after that edge, so margin >= 16.7 ns
//   CS setup                   drive cs_n = 0 for t_css ~ t_css / 10: held >= 90 ns before the first
//                              edge, which is the launch edge in this mode
//                              (a time: the CS edge shares the instant of the SCK drive, and
//                              a ratio is of the interval before an action, here 0, rule S5)
//   CS high                    held >= t_csd - 10 % = 90 ns >= 50 ns
//
//   other rates                60 MHz                              50 MHz
//   1 MHz (half 500 ns)        30 ticks, sample 58.8 -> 59, ok     25 ticks, sample 49, ok
//   7.5 MHz (half 66.7 ns)     4 ticks, sample 6.8 -> 7, ok        3.33 ticks: rise error 0.33 > 0.25, rejected
//   6.25 MHz (half 80 ns)      4.8 ticks: bit 1 at 9.6, error 0.4,  4 ticks, sample 7, ok
//                              rejected
// so the fastest clean rate is clk / 8 at either clock: 7.5 MHz at 60 MHz, 6.25 MHz at 50 MHz.
protocol spi_controller_mode1 {
  param f_sck : freq = 5 MHz;
  param t_rd  : time = 20 ns;          // MISO sample this long before the next launch edge
  param t_jit : time = 5 ns;           // placement tolerance of every SCK and MOSI edge
  param t_smp : time = 10 ns;          // placement tolerance of the MISO sample
  param t_css : time = 100 ns;         // CS low before the first launch
  param t_csd : time = 100 ns;         // CS high after a command
  unit  half  = 1 / (2 * f_sck);

  wire cs_n : out push_pull idle 1;
  wire sck  : out push_pull idle 0;
  wire mosi : out push_pull idle 0;
  wire miso : in;

  role ctl : controller uses cs_n, sck, mosi, miso {
    var op  : bits[8];
    var tx8 : bits[8];
    var rx8 : bits[8];
    var tx  : bits[32];
    var rx  : bits[32];

    state idle { on host.pull(op) -> dispatch; }

    state dispatch {
      after op == 1 -> select;
      after op == 2 -> load8;
      after op == 4 -> load32;
      after op == 3 -> deselect;
      after op != 0 -> idle;                       // unknown step: ignore it
    }

    state select {
      seq { drive sck = 0; drive cs_n = 0 for t_css ~ t_css / 10; } -> idle;
    }

    state load8  { on host.pull(tx8) -> xfer8; }
    state xfer8 {
      seq {
        repeat 8 {
          drive sck = 1;                                   // launch edge, shares the MOSI instant
          shift tx8 msb 1 -> mosi for half ~ t_jit;
          drive sck = 0 for half - t_rd ~ t_jit;           // the target samples MOSI
          shift miso -> rx8 msb 1 for t_rd ~ t_smp;
        }
        drive sck = 0 for half ~ t_jit;                    // back to idle before CS may change
        push host rx8;
      } -> idle;
    }

    state load32 { on host.pull(tx) -> xfer32; }
    state xfer32 {
      seq {
        repeat 32 {
          drive sck = 1;
          shift tx msb 1 -> mosi for half ~ t_jit;
          drive sck = 0 for half - t_rd ~ t_jit;
          shift miso -> rx msb 1 for t_rd ~ t_smp;
        }
        drive sck = 0 for half ~ t_jit;
        push host rx;
      } -> idle;
    }

    state deselect {
      seq { drive cs_n = 1 for t_csd ~ 10 %; } -> idle;
    }
  }
}
