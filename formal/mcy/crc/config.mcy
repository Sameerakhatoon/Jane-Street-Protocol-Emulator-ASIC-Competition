# Mutation coverage of tse_crc. test_eq: does the mutant change any output
# (original and mutant side by side, every configuration and input)?
# test_fm: the kill test, every output against the unit definition plus
# the CRC-32 catalogue value. test_cat: the first kill test (catalogue
# values only), kept to show what the new checks added.
[options]
size 40
tags COVERED UNCOVERED NOCHANGE CAT_MISSED

[script]
read -sv tse_crc.sv
prep -top tse_crc

[files]
tse_crc.sv
crc_props.sv
crc_full.sv
test_eq.sv
test_eq.sby
test_fm.sby
test_cat.sby
run_test.sh

[logic]
if result("test_eq") == "PASS":
    tag("NOCHANGE")
elif result("test_fm") == "PASS":
    tag("UNCOVERED")
else:
    tag("COVERED")
    if result("test_cat") == "PASS":
        tag("CAT_MISSED")

[report]
c, u, n = tags("COVERED"), tags("UNCOVERED"), tags("NOCHANGE")
print("killed %d of %d output-changing mutants (%.1f%%), %d had no effect, %d missed by the catalogue test"
      % (c, c + u, 100.0 * c / max(1, c + u), n, tags("CAT_MISSED")))

[test test_eq]
expect PASS FAIL
run bash $PRJDIR/run_test.sh test_eq

[test test_fm]
expect PASS FAIL
run bash $PRJDIR/run_test.sh test_fm

[test test_cat]
expect PASS FAIL
run bash $PRJDIR/run_test.sh test_cat
