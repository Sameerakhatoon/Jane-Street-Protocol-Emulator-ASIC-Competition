# Mutation coverage of tse_codec. test_eq: does the mutant change any output
# (original and mutant side by side, legal configurations, every input)?
# test_fm: the kill test, the round-trip proof on the mutant.
[options]
size 40
tags COVERED UNCOVERED NOCHANGE

[script]
read -sv tse_codec.sv
prep -top tse_codec

[files]
tse_codec.sv
codec_props.sv
test_eq.sv
test_eq.sby
test_fm.sby
run_test.sh

[logic]
if result("test_eq") == "PASS":
    tag("NOCHANGE")
elif result("test_fm") == "PASS":
    tag("UNCOVERED")
else:
    tag("COVERED")

[report]
c, u, n = tags("COVERED"), tags("UNCOVERED"), tags("NOCHANGE")
print("killed %d of %d output-changing mutants (%.1f%%), %d had no effect"
      % (c, c + u, 100.0 * c / max(1, c + u), n))

[test test_eq]
expect PASS FAIL
run bash $PRJDIR/run_test.sh test_eq

[test test_fm]
expect PASS FAIL
run bash $PRJDIR/run_test.sh test_fm
