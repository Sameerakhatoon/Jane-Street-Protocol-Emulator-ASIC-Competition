[tasks]
ni3   NI L3
own3  OWN L3
ni4   NI L4
own4  OWN L4

[options]
mode prove
depth 20

[engines]
smtbmc yices

[script]
NI: verilog_defines -DNI
read -formal tse_slot_arb.sv arb_props.sv
L3: chparam -set LANES 3 arb_props
L4: chparam -set LANES 4 arb_props
prep -top arb_props

[files]
tse_slot_arb.sv
arb_props.sv
