{
  "//": "Full-chip configuration (top tt_um_tse_sk_chip, 6x4, one 512x32 SRAM macro).",
  "//": "Template keys first (values kept unless the SRAM or the 60 MHz clock needs a change), then additions.",

  "//": "---- template keys we tune ----",
  "PL_TARGET_DENSITY_PCT": 60,
  "CLOCK_PERIOD": 16.67,
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.05,
  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,
  "CLOCK_PORT": "clk",

  "//": "---- template keys kept exactly ----",
  "RUN_KLAYOUT_XOR": 0,
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,
  "TOP_MARGIN_MULT": 1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT": 6,
  "RIGHT_MARGIN_MULT": 6,
  "FP_SIZING": "absolute",
  "GRT_ALLOW_CONGESTION": 1,
  "FP_IO_HLENGTH": 2,
  "FP_IO_VLENGTH": 2,
  "FP_PDN_VWIDTH": 2.1,
  "RUN_CTS": 1,
  "FP_PDN_MULTILAYER": 0,
  "MAGIC_DEF_LABELS": 0,
  "MAGIC_WRITE_LEF_PINONLY": 1,

  "//": "---- changed for the SRAM: Metal4 stripes at 6 x 11.24 um, offset so every stripe over the macro at x = 3.36 lands in a same-net column ----",
  "FP_PDN_VPITCH": 67.44,
  "FP_PDN_VSPACING": 3.52,
  "FP_PDN_VOFFSET": 40.2,
  "PDN_CFG": "dir::pdn_cfg.tcl",
  "RUN_KLAYOUT_DRC": 1,
  "KLAYOUT_DRC_RUNSET": "pdk_dir::libs.tech/klayout/tech/drc/ihp-sg13cmos5l.drc",
  "RUN_MAGIC_DRC": 0,
  "MAGIC_EXT_ABSTRACT_CELLS": ["RM_IHPSG13_.*"],
  "ERROR_ON_ILLEGAL_OVERLAPS": 0,

  "//": "---- timing ----",
  "PNR_CORNERS": ["nom_typ_1p20V_25C", "nom_slow_1p08V_125C"],
  "RUN_POST_GRT_RESIZER_TIMING": true,

  "//": "---- antenna: rule-based repair only ----",
  "DIODE_CELL": "sg13cmos5l_antennanp/A",
  "RUN_ANTENNA_REPAIR": 1,
  "RUN_HEURISTIC_DIODE_INSERTION": 0,
  "DRT_ANTENNA_REPAIR_ITERS": 6,

  "//": "---- routing diagnostics ----",
  "DRT_SAVE_DRC_REPORT_ITERS": 4,

  "//": "---- the SRAM macro: bottom-left, flipped so the pin edge faces the logic ----",
  "MACROS": {
    "RM_IHPSG13_1P_512x32_c2_bm_bist": {
      "gds":   ["pdk_dir::libs.ref/sg13cmos5l_sram/gds/RM_IHPSG13_1P_512x32_c2_bm_bist.gds"],
      "lef":   ["pdk_dir::libs.ref/sg13cmos5l_sram/lef/RM_IHPSG13_1P_512x32_c2_bm_bist.lef"],
      "spice": ["pdk_dir::libs.ref/sg13cmos5l_sram/cdl/RM_IHPSG13_1P_512x32_c2_bm_bist.cdl"],
      "nl": [],
      "spef": {},
      "lib": {
        "nom_typ_1p20V_25C":   ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_512x32_c2_bm_bist_typ_1p20V_25C.lib"],
        "nom_fast_1p32V_m40C": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_512x32_c2_bm_bist_fast_1p32V_m55C.lib"],
        "nom_slow_1p08V_125C": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_512x32_c2_bm_bist_slow_1p08V_125C.lib"]
      },
      "instances": {
        "u_chip.u_top.u_pmem.u_sram.u_macro": { "location": [3.36, 3.78], "orientation": "FS" }
      }
    }
  },
  "PDN_MACRO_CONNECTIONS": [
    "u_chip\\.u_top\\.u_pmem\\.u_sram\\.u_macro VPWR VGND VDD! VSS!",
    "u_chip\\.u_top\\.u_pmem\\.u_sram\\.u_macro VPWR VGND VDDARRAY! VSS!"
  ],
  "FP_MACRO_HORIZONTAL_HALO": 2.0,
  "FP_MACRO_VERTICAL_HALO": 0.48
