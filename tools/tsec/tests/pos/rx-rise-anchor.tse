// build
// An inverted-line receiver: idle low, start bit high, anchored on rise(rx).
protocol inverted_rx {
  param baud : freq = 230400 Hz;
  unit  bit  = 1 / baud;

  wire rx : in;

  role rx_side : target uses rx {
    var b : bits[8];
    state idle  { on rise(rx) -> frame; }
    state frame {
      seq {
        sample rx expect 1 within [0.35 bit, 0.65 bit] after rise(rx) for 1 bit;
        shift rx -> b lsb 8 each 1 bit ~ 2.5 %;
        sample rx expect 0 for 0.5 bit ~ 2.5 %;
        push host b;
      } -> idle;
    }
  }
}
