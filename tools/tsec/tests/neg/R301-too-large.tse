// 130 drives, two instructions each: more than a lane's 256
protocol p {
  wire tx : out;
  role r : controller uses tx {
    var b : bits[8];
    state idle { on host.pull(b) -> f; }
    state f {
      seq {
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
        drive tx = 0 for 1 us;
        drive tx = 1 for 1 us;
      } -> idle;
    }
  }
}
