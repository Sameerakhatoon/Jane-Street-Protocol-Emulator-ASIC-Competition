// a sample window narrower than one tick can never be met
protocol p {
  wire rx : in;
  role r : target uses rx {
    var b : bits[8];
    state idle { on fall(rx) -> f; }
    state f {
      seq {
        sample rx expect 0 within [1 us, 1.01 us] after fall(rx) for 10 us;
        shift rx -> b lsb 8 each 10 us ~ 2 %;
        push host b;
      } -> idle;
    }
  }
}
