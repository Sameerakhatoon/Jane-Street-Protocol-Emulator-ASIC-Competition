// 30 Mbaud: a 2-tick bit period is shorter than the paced loop body
protocol p {
  param baud : freq = 30 MHz;
  unit  bit  = 1 / baud;
  wire tx : out;
  role r : controller uses tx {
    var b : bits[8];
    state idle { on host.pull(b) -> f; }
    state f { seq { shift b lsb 8 -> tx each 1 bit ~ 50 %; } -> idle; }
  }
}
