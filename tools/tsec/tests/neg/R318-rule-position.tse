// a fixed-position rule past the saturating frame counter
protocol p {
  wire rx : in;
  assist late : rule { pattern = 1; pos = 250; offset = 8; }
  role r : target uses rx {
    var b : bits[8];
    state idle { on fall(rx) -> f; }
    state f {
      seq {
        sample rx expect 0 within [4 us, 6 us] after fall(rx) for 10 us;
        shift rx -> b lsb 8 each 10 us ~ 2 %;
        push host b;
      } -> idle;
    }
  }
}
